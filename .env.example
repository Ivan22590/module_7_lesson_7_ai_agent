# ============================================================
# Шаблон переменных окружения для Telegram AI-агента
# Скопируйте этот файл в .env и заполните значениями:
#   cp .env.example .env
# ============================================================

# Токен Telegram-бота, полученный у @BotFather (ОБЯЗАТЕЛЬНО)
TG_BOT_API_KEY=your_telegram_bot_token

# Ключ ProxyAPI (OpenAI-совместимый провайдер) (ОБЯЗАТЕЛЬНО)
# Получить: https://proxyapi.ru
PROXYAPI_API_KEY=your_proxyapi_key

# Базовый URL ProxyAPI (OpenAI-совместимый эндпоинт)
PROXYAPI_API_BASE=https://api.proxyapi.ru/v1

# Имя модели, которую использует агент
LLM_MODEL=openai/gpt-5.6-luna

# Температура генерации (0.0 - детерминированно, 1.0 - креативно)
LLM_TEMPERATURE=0.1

# ------------------------------------------------------------
# Примечание: Weather и Crypto используют бесплатные API без ключей,
# но эти строки оставлены для будущей расширяемости.
# ------------------------------------------------------------
WEATHER_API_KEY=optional
CURRENCY_API_KEY=optional
